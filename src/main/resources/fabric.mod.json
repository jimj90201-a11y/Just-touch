
{
  "schemaVersion": 1,
  "id": "justtouch",
  "version": "${version}",
  "name": "Just Touch",
  "description": "Touchscreen compatibility helper for Minecraft Java Edition.",
  "authors": ["GamerOfPro"],
  "contact": {
