
{
  "schemaVersion": 1,
  "id": "justtouch",
  "version": "${version}",
  "name": "Just Touch",
  "description": "A client-side touchscreen control mod for Minecraft Java Edition, designed for touch devices and compatible launchers.",
  "authors": [
    "GamerOfPro"
  ],
  "contact": {
    "sources": "https://github.com/gamerofpro/just-touch"
  },
  "license": "MIT",
  "icon": "assets/justtouch/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "gamerofpro.justtouch.client.JustTouchClient"
    ],
    "fabric-datagen": [
      "gamerofpro.justtouch.client.JustTouchDataGenerator"
    ]
  },
  "mixins": [
    "justtouch.mixins.json",
    {
      "config": "justtouch.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  }
}
